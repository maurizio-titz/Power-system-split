
configfile: "configs/config.sclopf.yaml"
configfile: "configs/config.yaml"

import numpy as np
import os
import sys

root_path = "../../"
sys.path.append(root_path)


group_size = int(config["groupsize"])
temp_resolution = int("".join(filter(str.isdigit, config["clustering"]["temporal"]["averaging"])))

N_ITER = str(int(np.ceil(8760 / temp_resolution / group_size))-1)
NCLUSTERS = str(config["clustering"]["cluster_network"]["n_clusters"])

_horizons = config["planning_horizons"]
HORIZON = str(_horizons[0] if isinstance(_horizons, list) else _horizons)


def co2_run_name(opts):
    """'Co2L0.6' (this workflow's {opts} wildcard) -> 'co2-0.6' (pypsa-eur run.name)"""
    return "co2-" + opts.replace("Co2L", "")


# export PYTHONPATH=str(base_repository_path):$PYTHONPATH

from utils.config import path_to_sclopf_data


rule prepare_sclopf:
    input:
        network = lambda w: "submodules/pypsa-eur/results/" + co2_run_name(w.opts) + f"/networks/solved_{HORIZON}.nc",
    output: path_to_sclopf_data + f"/prenetworks/elec_s_" + NCLUSTERS + "_ec_lv1.0_{opts}_prepared.nc"
    resources: mem=4000
    threads: 4
    script: "scripts/prepare_sclopf.py"


rule solve_sclopf:
    input: 
        prepared = path_to_sclopf_data + "/prenetworks/elec_s_" + NCLUSTERS + "_ec_lv1.0_{opts}_prepared.nc",
        previous = lambda w: path_to_sclopf_data + f"/postnetworks/{w.opts}/sclopf-elec_s_" + NCLUSTERS + f"_ec_lv1.0-{int(w.i)-1}.nc" if int(w.i) > 0 else []
    output: path_to_sclopf_data + "/postnetworks/{opts}/sclopf-elec_s_" + NCLUSTERS + "_ec_lv1.0-{i}.nc"
    resources: mem_mb=100000
    threads: 4
    script: "scripts/solve_sclopf.py"


rule reassemble_all:
    input:
        pre = path_to_sclopf_data + "/prenetworks/elec_s_" + NCLUSTERS + "_ec_lv1.0_{opts}_prepared.nc",
        sub = path_to_sclopf_data + "/postnetworks/{opts}/sclopf-elec_s_" + NCLUSTERS + "_ec_lv1.0-" + N_ITER + ".nc"
    output: path_to_sclopf_data + "/sclopf-elec_s_" + NCLUSTERS + "_ec_lv1.0_{opts}.nc"
    script: "scripts/reassemble.py"


rule run_all:
    input:
        expand(
            path_to_sclopf_data + "/postnetworks/Co2L{Co2L}/sclopf-elec_s_" + NCLUSTERS + "_ec_lv1.0-{i}.nc",
            Co2L = config["Co2-scenarios"],
            i = [n for n in range(int(np.ceil(8760 / temp_resolution / group_size)))],
            onerror=lambda e: print(f"Warning: {e} failed, continuing..."),
        ),
        expand(
            path_to_sclopf_data + "/sclopf-elec_s_" + NCLUSTERS + "_ec_lv1.0_Co2L{Co2L}.nc",
            Co2L = config["Co2-scenarios"],
            onerror=lambda e: print(f"Warning: {e} failed, continuing..."),
        )


# ============================================================================
# Weather-year sensitivity: same SC-LOPF redispatch (prepare_sclopf.py /
# solve_sclopf.py / reassemble.py, all reused UNCHANGED below) but starting
# from the OLD, externally-solved 600-cluster LOPF networks
# (/srv/data/jlange/PYPSA2/to_copy/...) with fixed capacities/topology, and
# swapping in a different weather year's renewable/hydro time series before
# redispatch. See /home/jlange/.claude/plans/clever-imagining-walrus.md for
# the full design rationale.
# ============================================================================

# needed so the reused pypsa-eur scripts' own `from scripts._helpers import ...`
# (and similar) resolve, mirroring submodules/pypsa-eur/rules/common.smk:15-16
sys.path.insert(0, os.path.abspath("submodules/pypsa-eur"))

import yaml as _yaml

with open("submodules/pypsa-eur/config/config.default.yaml") as _f:
    _PYPSA_EUR_DEFAULTS = _yaml.safe_load(_f)

# submodules/pypsa-eur/scripts/build_hydro_profile.py:184 reads
# snakemake.config["renewable"]["hydro"] directly (in addition to the
# snakemake.params.hydro we already pass it) - our own config.yaml/
# config.sclopf.yaml have no top-level "renewable" section, so inject
# pypsa-eur's default one to satisfy that direct lookup.
config.setdefault("renewable", _PYPSA_EUR_DEFAULTS["renewable"])

# brownfield source for the weather-year variant: this workflow's own current
# (NCLUSTERS-node) 2013 LOPF solve, not the old 600-node reference networks -
# swap_weather_year.py is generic (point-samples by bus x/y), so it works on
# either, and using our own solve keeps this consistent with the regular
# sclopf/lopf pipeline (same clustering, base_network, cost data, ...).

WEATHER_CUTOUT_PARAMS = {
    "module": "era5",
    "x": [-12.0, 42.0],
    "y": [33.0, 72.0],
    "dx": 0.3,
    "dy": 0.3,
    "prepare_kwargs": {"features": ["wind", "influx", "temperature", "height", "runoff"]},
}


# pypsa-eur hosts pre-built cutouts for these years at data.pypsa.org (confirmed
# via HEAD request: https://pypsa-eur.readthedocs.io/en/latest/data-cutouts/) -
# for any of them, just download instead of building via CDS/atlite. Anything
# else falls through to build_weather_cutout below (needs ~/.cdsapirc).
ARCHIVED_CUTOUT_YEARS = ["1995", "1996", "2008", "2009", "2010", "2012", "2013",
                         "2019", "2020", "2021", "2023", "2024", "2025"]


def cutout_name(year):
    """Archived years ship as era5+sarah3-blended cutouts (better solar data);
    anything else is built era5-only via CDS (see build_weather_cutout)."""
    year = str(year)
    suffix = "sarah3-era5" if year in ARCHIVED_CUTOUT_YEARS else "era5"
    return f"europe-{year}-{suffix}"


ruleorder: retrieve_weather_cutout > build_weather_cutout


rule retrieve_weather_cutout:
    output:
        cutout="data/cutouts/{cutout}.nc",
    params:
        url=lambda w: f"https://data.pypsa.org/workflows/cutout/v1.0/{w.cutout}.nc",
    wildcard_constraints:
        cutout="europe-(" + "|".join(ARCHIVED_CUTOUT_YEARS) + ")-sarah3-era5",
    resources:
        mem_mb=2000,
    run:
        import urllib.request
        print(f"Downloading pre-built cutout from {params.url} (several GB, no CDS credentials needed)")
        urllib.request.urlretrieve(params.url, output.cutout)


rule build_weather_cutout:
    output:
        cutout="data/cutouts/{cutout}.nc",
    params:
        # submodules/pypsa-eur/scripts/build_cutout.py hardcodes
        # snakemake.wildcards.cutout and snakemake.params.cutouts[that wildcard],
        # so the wildcard here must be named "cutout" (matching pypsa-eur's own
        # rule), not "weather_year" - the year is recovered from the cutout name.
        cutouts=lambda w: {
            w.cutout: {
                **WEATHER_CUTOUT_PARAMS,
                "time": [w.cutout.split("-")[1], w.cutout.split("-")[1]],
            }
        },
    wildcard_constraints:
        cutout=r"europe-\d{4}-era5",
    resources:
        mem_mb=8000,
    script:
        "submodules/pypsa-eur/scripts/build_cutout.py"


rule build_weather_hydro_profile:
    input:
        # country_shapes.geojson is independent of clustering/weather year,
        # so any existing solved scenario's copy works
        country_shapes="submodules/pypsa-eur/resources/co2-0.1/country_shapes.geojson",
        eia_hydro_generation="submodules/pypsa-eur/data/eia_hydro_annual_generation.csv",
        eia_hydro_capacity="submodules/pypsa-eur/data/eia_hydro_annual_capacity.csv",
        era5_runoff="submodules/pypsa-eur/data/country_runoff/archive/2025-08-13/era5-runoff-per-country.csv",
        cutout=lambda w: f"data/cutouts/{cutout_name(w.weather_year)}.nc",
    output:
        profile="data/cutouts/profile_hydro_{weather_year}.nc",
    params:
        hydro=_PYPSA_EUR_DEFAULTS["renewable"]["hydro"],
        countries=_PYPSA_EUR_DEFAULTS["countries"],
        snapshots=lambda w: {
            "start": f"{w.weather_year}-01-01",
            "end": f"{int(w.weather_year) + 1}-01-01",
            "inclusive": "left",
        },
        drop_leap_day=_PYPSA_EUR_DEFAULTS["enable"]["drop_leap_day"],
    wildcard_constraints:
        weather_year=r"\d{4}",
    resources:
        mem_mb=5000,
    script:
        "submodules/pypsa-eur/scripts/build_hydro_profile.py"


rule swap_weather_year:
    input:
        network=lambda w: "submodules/pypsa-eur/results/" + co2_run_name(w.opts) + f"/networks/solved_{HORIZON}.nc",
        cutout=lambda w: f"data/cutouts/{cutout_name(w.weather_year)}.nc",
        hydro_profile="data/cutouts/profile_hydro_{weather_year}.nc",
    output:
        path_to_sclopf_data + f"_weather/base/elec_s_" + NCLUSTERS + "_ec_lv1.0_" + "{opts}_weather{weather_year}.nc",
    params:
        renewable=_PYPSA_EUR_DEFAULTS["renewable"],
    resources:
        mem_mb=8000,
    script:
        "scripts/swap_weather_year.py"


rule solve_operation_weather:
    # Fixed-capacity annual LOPF (operation only, no expansion) under the
    # swapped weather year, so prepare_sclopf_weather's force_storage='all'
    # pins a state_of_charge trajectory that's actually consistent with this
    # weather year's inflow, instead of the stale 2013 trajectory carried
    # over unchanged from solved_{HORIZON}.nc by swap_weather_year.py.
    input:
        network=path_to_sclopf_data + f"_weather/base/elec_s_" + NCLUSTERS + "_ec_lv1.0_" + "{opts}_weather{weather_year}.nc",
    output:
        path_to_sclopf_data + f"_weather/operation/elec_s_" + NCLUSTERS + "_ec_lv1.0_" + "{opts}_weather{weather_year}_operated.nc"
    resources: mem_mb=100000
    threads: 4
    script: "scripts/solve_operation_weather.py"


rule prepare_sclopf_weather:
    input:
        network=path_to_sclopf_data + f"_weather/operation/elec_s_" + NCLUSTERS + "_ec_lv1.0_" + "{opts}_weather{weather_year}_operated.nc",
    output:
        path_to_sclopf_data + f"_weather/prenetworks/elec_s_" + NCLUSTERS + "_ec_lv1.0_" + "{opts}_weather{weather_year}_prepared.nc"
    resources: mem=4000
    threads: 4
    # reused unchanged; freeze_extendable_capacities/overdim_extendables are now
    # no-ops here since solve_operation_weather already froze all capacities
    # (kept shared with the non-weather config since that rule still uses them)
    script: "scripts/prepare_sclopf.py"


rule solve_sclopf_weather:
    input:
        prepared=path_to_sclopf_data + f"_weather/prenetworks/elec_s_" + NCLUSTERS + "_ec_lv1.0_" + "{opts}_weather{weather_year}_prepared.nc",
        previous=lambda w: path_to_sclopf_data + f"_weather/postnetworks/{w.opts}_weather{w.weather_year}/sclopf-elec_s_" + NCLUSTERS + f"_ec_lv1.0-{int(w.i)-1}.nc" if int(w.i) > 0 else []
    output:
        path_to_sclopf_data + f"_weather/postnetworks/" + "{opts}_weather{weather_year}" + f"/sclopf-elec_s_" + NCLUSTERS + "_ec_lv1.0-" + "{i}.nc"
    resources: mem_mb=100000
    threads: 4
    script: "scripts/solve_sclopf.py"   # reused unchanged


rule reassemble_weather:
    input:
        pre=path_to_sclopf_data + f"_weather/prenetworks/elec_s_" + NCLUSTERS + "_ec_lv1.0_" + "{opts}_weather{weather_year}_prepared.nc",
        sub=path_to_sclopf_data + f"_weather/postnetworks/" + "{opts}_weather{weather_year}" + f"/sclopf-elec_s_" + NCLUSTERS + "_ec_lv1.0-" + N_ITER + ".nc"
    output:
        path_to_sclopf_data + f"_weather/sclopf-elec_s_" + NCLUSTERS + "_ec_lv1.0_" + "{opts}_weather{weather_year}.nc"
    script: "scripts/reassemble.py"   # reused unchanged


rule run_all_weather:
    input:
        expand(
            path_to_sclopf_data + f"_weather/sclopf-elec_s_" + NCLUSTERS + "_ec_lv1.0_" + "Co2L{Co2L}_weather{weather_year}.nc",
            Co2L = config["Co2-scenarios"],
            weather_year = config["weather_years"],
            onerror=lambda e: print(f"Warning: {e} failed, continuing..."),
        )


